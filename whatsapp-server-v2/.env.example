# QuickZap WhatsApp server (v2)
PORT=3000
NODE_ENV=production

# Laravel app base URL (webhooks are POSTed to {BASE_URL}/api/whatsapp-web/webhook)
BASE_URL=http://127.0.0.1:8000

# Same MySQL DB the platform uses (shared `session` table for auth)
DATABASE_URL="mysql://root:@localhost:3306/whatsml"

ENABLE_WEBHOOK=true
ENABLE_WEBSOCKET=true

LOG_LEVEL=info

# Reconnect / stability tuning
RECONNECT_BASE_DELAY_MS=2000
RECONNECT_MAX_DELAY_MS=60000
MAX_RECONNECT_RETRIES=0          # 0 = unlimited (recommended for long-lived sessions)
KEEPALIVE_INTERVAL_MS=20000
CONNECT_TIMEOUT_MS=30000
QR_MAX_RETRIES=5

# Anti-ban behaviour
MARK_ONLINE_ON_CONNECT=false     # do not broadcast "online" on connect
SEND_PRESENCE_BEFORE_SEND=true   # show "typing" briefly before sending (human-like)
SYNC_FULL_HISTORY=false          # faster connect, lighter load

# Optional shared secret required on incoming API requests (X-Api-Key header)
API_KEY=

# Realtime socket auth: MUST match Laravel's WHATSAPP_WEB_SOCKET_SECRET.
# Generate one: openssl rand -hex 32
SOCKET_SECRET=
